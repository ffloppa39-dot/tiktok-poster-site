{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tiktok-poster-site",
  "main": "src/index.js",
  "compatibility_date": "2026-10-22",
  "workers_dev": true,
  "observability": { "enabled": true },
  "kv_namespaces": [
    { "binding": "TOKENS", "id": "ebbc87251fcd4a50a90e8460eec50ced" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "AGENT_UPLOAD_GUARD", "class_name": "AgentUploadGuard" }
    ]
  },
  "migrations": [
    { "tag": "agent-upload-guard-v1", "new_classes": ["AgentUploadGuard"] }
  ]
}
